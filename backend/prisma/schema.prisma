datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads          Lead[]
  templates      MessageTemplate[]
  followUps      FollowUp[]
  importJobs     ImportJob[]
  contactHistory ContactHistory[]
  activityLogs   ActivityLog[]
  settings       Settings?
  queueSessions  OutreachQueueSession[]
}

model Lead {
  id               String    @id @default(uuid())
  userId           String
  businessName     String
  category         String?   @default("General Business")
  phone            String?
  normalizedPhone  String?
  country          String?   @default("IN")
  state            String?
  city             String?
  address          String?
  rating           Float?    @default(0.0)
  reviews          Int?      @default(0)
  website          String?
  email            String?
  status           String    @default("PENDING") // PENDING, WHATSAPP_OPENED, CONTACTED, FOLLOW_UP, INTERESTED, NOT_INTERESTED, CONVERTED
  whatsappOpenedAt DateTime?
  contactedAt      DateTime?
  contactedBy      String?
  followUpDate     DateTime?
  notes            String?
  importJobId      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  importJob      ImportJob?       @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  contactHistory ContactHistory[]
  followUps      FollowUp[]
  activityLogs   ActivityLog[]

  @@index([userId])
  @@index([normalizedPhone])
  @@index([businessName])
  @@index([category])
  @@index([city])
  @@index([status])
}

model MessageTemplate {
  id        String   @id @default(uuid())
  userId    String
  name      String
  category  String   @default("General Business")
  content   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactHistory {
  id           String   @id @default(uuid())
  leadId       String
  userId       String
  action       String   // e.g. WHATSAPP_OPENED, MARKED_CONTACTED, STATUS_CHANGED
  notes        String?
  templateUsed String?
  timestamp    DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
}

model FollowUp {
  id        String   @id @default(uuid())
  leadId    String
  userId    String
  title     String
  date      DateTime
  time      String?
  notes     String?
  status    String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
}

model ImportJob {
  id              String   @id @default(uuid())
  userId          String
  fileName        String
  fileType        String
  fileSize        Int
  recordsDetected Int      @default(0)
  importedCount   Int      @default(0)
  duplicateCount  Int      @default(0)
  invalidCount    Int      @default(0)
  status          String   @default("COMPLETED")
  createdAt       DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads   Lead[]
  records ImportRecord[]

  @@index([userId])
}

model ImportRecord {
  id           String   @id @default(uuid())
  importJobId  String
  rawData      String   // JSON string
  isImported   Boolean  @default(false)
  isDuplicate  Boolean  @default(false)
  isInvalid    Boolean  @default(false)
  errorMessage String?
  createdAt    DateTime @default(now())

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  leadId    String?
  action    String
  details   String?
  timestamp DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Settings {
  id                String   @id @default(uuid())
  userId            String   @unique
  companyName       String   @default("PJN Technologies")
  companySignature  String   @default("— PJN Technologies")
  defaultCountry    String   @default("IN (+91)")
  defaultTemplateId String?
  autoMarkContacted Boolean  @default(false)
  whatsappBehavior  String   @default("web") // 'web' or 'app'
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutreachQueueSession {
  id                  String   @id @default(uuid())
  userId              String   @unique
  currentLeadId       String?
  filterStatus        String   @default("PENDING,WHATSAPP_OPENED,FOLLOW_UP")
  totalEligible       Int      @default(0)
  contactedCount      Int      @default(0)
  whatsappOpenedCount Int      @default(0)
  remainingCount      Int      @default(0)
  lastActiveAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===== SVGS CONSTRUCTIONS MODELS =====

model SvgsProject {
  id          String   @id @default(uuid())
  name        String
  location    String
  projectType String
  status      String   @default("ONGOING")
  progress    Int      @default(0)
  area        String?
  description String?
  coverImage  String?
  milestones  String?
  featured    Boolean  @default(false)
  lastUpdated String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  images SvgsProjectImage[]

  @@index([status])
  @@index([featured])
}

model SvgsProjectImage {
  id        String   @id @default(uuid())
  projectId String
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project SvgsProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model SvgsTestimonial {
  id            String   @id @default(uuid())
  clientName    String
  location      String?
  projectType   String?
  rating        Int      @default(5)
  text          String
  isVisible     Boolean  @default(true)
  isPlaceholder Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SvgsEnquiry {
  id          String   @id @default(uuid())
  name        String
  phone       String
  location    String?
  projectType String?
  budget      String?
  message     String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model SvgsGalleryImage {
  id        String   @id @default(uuid())
  url       String
  caption   String?
  projectId String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
